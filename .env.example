# Frontend Environment Configuration (Public variables accessible by client)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Test credentials for database RLS policies verification
TEST_USER_A_EMAIL=your_test_user_a_email_here
TEST_USER_A_PASSWORD=your_test_user_a_password_here
TEST_USER_B_EMAIL=your_test_user_b_email_here
TEST_USER_B_PASSWORD=your_test_user_b_password_here

# Throwaway account for the account-deletion suite. Unlike users A and B this one is
# destroyed and re-created from scratch on every run, so never point it at an account you
# care about. The values below are fine as-is -- the suite creates the account itself.
TEST_THROWAWAY_EMAIL=awayinvault-throwaway@example.com
TEST_THROWAWAY_PASSWORD=Throwaway-Delete-Me-9f3a2b!

# Supabase secret (service_role) key. TESTS ONLY -- used by accountDeletion.test.ts to
# create TEST_USER_C pre-confirmed, so the suite stays automatic without turning off
# email confirmation on the project.
#
# This key bypasses ALL row level security. Never give it a PUBLIC_ prefix (Vite would
# bundle it into client JS) and never import it from src/ or cli/ -- test files only.
# If it ever leaks, rotate it in the Supabase dashboard under Settings > API Keys.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Optional Master Password for non-interactive CLI usage (agent scripting)
# AWAYINVAULT_MASTER_PASSWORD=your_master_password_here

# Base URL of the web application (used by CLI for login redirects)
PUBLIC_APP_URL=http://localhost:5173


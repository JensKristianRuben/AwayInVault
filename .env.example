# Frontend Environment Configuration (Public variables accessible by client)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Test credentials for database RLS policies verification
TEST_USER_A_EMAIL=your_test_user_a_email_here
TEST_USER_A_PASSWORD=your_test_user_a_password_here
TEST_USER_B_EMAIL=your_test_user_b_email_here
TEST_USER_B_PASSWORD=your_test_user_b_password_here

# Optional Master Password for non-interactive CLI usage (agent scripting)
# AWAYINVAULT_MASTER_PASSWORD=your_master_password_here

# Base URL of the web application (used by CLI for login redirects)
PUBLIC_APP_URL=http://localhost:5173


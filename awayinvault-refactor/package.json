{
	"name": "awayinvault-refactor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && cd .. && husky awayinvault-refactor/.husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:crypto": "npx vitest src/lib/test/crypto.test.ts",
		"format:check": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/node": "^26.0.1",
		"autoprefixer": "^10.5.0",
		"dotenv": "^17.4.2",
		"husky": "^9.1.7",
		"postcss": "^8.5.15",
		"prettier": "^3.9.1",
		"prettier-plugin-svelte": "^4.1.1",
		"supabase": "^2.108.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.108.1",
		"svelte-sonner": "^1.1.1"
	}
}
